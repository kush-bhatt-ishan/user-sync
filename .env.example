PS_TOKEN_URL=https://auth.peoplestrong.com/auth/realms/1454/protocol/openid-connect/token
PS_API_URL=https://api.peoplestrong.com/api/integration/Outbound/IshanInfotechLimited_HRIS_EmployeedataD365
PS_APIKEY=your-peoplestrong-api-key
PS_INTEGRATION_NAME=EmployeedataD365
PS_CLIENT_ID=your-peoplestrong-client-id
PS_CLIENT_SECRET=your-peoplestrong-client-secret

AZ_TENANT_ID=your-tenant-id
AZ_CLIENT_ID=your-azure-client-id-for-graph-api
AZ_CLIENT_SECRET=your-azure-client-secret-for-graph-api

# Microsoft SSO login (separate App Registration with User.Read scope)
AZ_SSO_CLIENT_ID=your-azure-sso-app-client-id
AZ_SSO_CLIENT_SECRET=your-azure-sso-app-client-secret
AZ_SSO_REDIRECT_URI=http://localhost:8000/auth/callback/

SYNC_CREATE=false
SYNC_UPDATE=true
SYNC_DISABLE=false

LOG_LEVEL=INFO
LOG_FILE=sync.log
DEFAULT_COMPANY_NAME=Ishan Technologies
